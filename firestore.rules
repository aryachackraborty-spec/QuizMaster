rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net: Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Safety Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "arya.chakraborty.fiem.cse25@teamfuture.in"
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Entity Schema Validators
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'username', 'avatar', 'xp', 'level', 'streakDays', 'gamesPlayed', 'correctAnswersRate', 'coins', 'createdAt', 'updatedAt'])
        && data.keys().size() <= 14
        && data.uid is string && data.uid.size() <= 128
        && data.username is string && data.username.size() >= 2 && data.username.size() <= 50
        && data.avatar is string && data.avatar.size() <= 10
        && data.xp is int && data.xp >= 0
        && data.level is int && data.level >= 0
        && data.streakDays is int && data.streakDays >= 0
        && data.gamesPlayed is int && data.gamesPlayed >= 0
        && (data.correctAnswersRate is float || data.correctAnswersRate is int)
        && data.coins is int && data.coins >= 0
        && (!data.keys().hasAny(['wins']) || data.wins is int)
        && (!data.keys().hasAny(['badges']) || data.badges is list)
        && (!data.keys().hasAny(['achievements']) || data.achievements is list);
    }

    function isValidRoom(data) {
      return data.keys().hasAll(['code', 'quizTitle', 'description', 'category', 'difficulty', 'status', 'currentQuestionIndex', 'timer', 'hostId', 'questions', 'reactions', 'activityFeed', 'lastUpdate', 'createdAt'])
        && data.keys().size() <= 15
        && data.code is string && data.code.size() == 4
        && data.quizTitle is string && data.quizTitle.size() <= 120
        && data.description is string && data.description.size() <= 500
        && data.category is string && data.category.size() <= 100
        && data.difficulty is string && data.difficulty.size() <= 50
        && data.status is string && (data.status == 'lobby' || data.status == 'active' || data.status == 'ended')
        && data.currentQuestionIndex is int
        && data.timer is int
        && data.hostId is string && data.hostId.size() <= 128
        && data.questions is list && data.questions.size() <= 20
        && data.reactions is list && data.reactions.size() <= 40
        && data.activityFeed is list && data.activityFeed.size() <= 100
        && data.lastUpdate is int;
    }

    function isValidPlayer(data) {
      return data.keys().hasAll(['id', 'username', 'avatar', 'score', 'streak', 'comboCount', 'isBot', 'isReady', 'joinedAt'])
        && data.keys().size() <= 12
        && data.id is string && data.id.size() <= 128
        && data.username is string && data.username.size() >= 2 && data.username.size() <= 50
        && data.avatar is string && data.avatar.size() <= 10
        && data.score is int && data.score >= 0
        && data.streak is int && data.streak >= 0
        && data.comboCount is int && data.comboCount >= 0
        && data.isBot is bool
        && data.isReady is bool;
    }

    // 3. Collection Rule Gates

    // /users/{userId} - User profiles containing progress & stats
    match /users/{userId} {
      allow read: if true; // Support loading public stats / leaderboard for anyone
      allow create: if isSignedIn() 
        && isValidUser(incoming()) 
        && isOwner(userId)
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      
      allow update: if isSignedIn() 
        && isValidUser(incoming()) 
        && (isOwner(userId) || isAdmin())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;

      allow delete: if isAdmin();
    }

    // /rooms/{roomCode} - Active multiplayer Rooms (supports unauthenticated reads & server writes)
    match /rooms/{roomCode} {
      allow read: if true; 
      allow create: if isValidId(roomCode)
        && isValidRoom(incoming());

      // Allow targeted actions on update
      allow update: if isValidId(roomCode)
        && isValidRoom(incoming());

      allow delete: if true;

      // Subcollection: Players inside rooms
      match /players/{playerId} {
        allow read: if true;
        allow create: if isValidId(playerId)
          && isValidPlayer(incoming());

        allow update: if isValidId(playerId)
          && isValidPlayer(incoming());

        allow delete: if true;
      }
    }
  }
}
